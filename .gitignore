# Python (backend)
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
*.pyc

# Environment secrets — never commit these
.env
.env.local
backend/.env
frontend/.env.local

# Node / Next.js (frontend)
frontend/node_modules/
frontend/.next/
frontend/out/

# OS junk
.DS_Store
Thumbs.db

# Editor
.vscode/

# Generated data — keep the generator script, not every run's output
data/output/*.csv
!data/output/.gitkeep
.gstack/

# Next.js auto-generates these at frontend/ with `agentRules: true` (the
# default) — disabled via `agentRules: false` in frontend/next.config.ts,
# but ignore them here too in case that config is ever missing/reverted.
# Real project conventions live only at the repo root (AGENTS.md, CLAUDE.md).
frontend/AGENTS.md
frontend/CLAUDE.md